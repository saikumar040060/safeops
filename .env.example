# --- Database ---
POSTGRES_USER=safeops
POSTGRES_PASSWORD=safeops
POSTGRES_DB=safeops
# Host-side URL (docker-compose maps postgres to 5433 on the host to avoid
# clashing with a locally installed Postgres on 5432). Containers talk to
# each other over the internal network on the default 5432, see docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://safeops:safeops@localhost:5433/safeops

# --- API ---
APP_NAME=SafeOps API
# development | production. Production refuses to start unless every check
# in app/core/config.py::validate_production_safety passes.
SAFEOPS_ENV=development
# Must be false in production -- seeds well-known demo operator accounts
# and enables the frontend's demo-mode banner. Never set true in production;
# the app will refuse to start if you do.
SAFEOPS_DEMO_MODE=true
CORS_ORIGINS=["http://localhost:3000"]
MAX_EXECUTION_STEPS=25
STEPPING_LEASE_TTL_SECONDS=30
# Required in production only: seeds exactly one ADMIN operator/token on
# first startup so there is a way in before any other account exists.
# Placeholder only -- set a real >=32 character secret, never commit one.
SAFEOPS_BOOTSTRAP_ADMIN_TOKEN=changeme-generate-a-real-32-char-secret
SAFEOPS_BOOTSTRAP_ADMIN_USERNAME=admin

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
